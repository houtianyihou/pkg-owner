#!/bin/sh
# Compatibility entry point; all CLI functionality is implemented in Rust.
set -eu
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
binary="$project_dir/target/release/pkg-owner"
if [ ! -x "$binary" ]; then
    printf '%s\n' '请先在项目目录执行 cargo build --release --locked' >&2
    exit 1
fi
exec "$binary" "$@"
